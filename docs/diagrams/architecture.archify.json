  "cards": [
    {
      "dot": "violet",
      "title": "配布",
      "items": [
        "npx skills add で csa と csa-worker の 2 つの skill を入れる",
        "csa init が ~/.local/bin/csa と ~/.csa を用意する",
        "herdr、jq、git は環境のものを使い、csa init が欠けを報告する"
      ]
    },
    {
      "dot": "rose",
      "title": "承認ゲート",
      "items": [
        "plan が要る課題では Worker が止まり、人間が承認したあとに CSA が csa approve を実行する",
        "csa spawn、csa close、herdr agent prompt は自動では許可しない",
        "起動直後のフォルダの信頼の確認は、人間が Worker のペインで承認する",
        "人間は Worker のペインで直接やり取りでき、Worker は変わった状態を csa report で記録する"
      ]
    },
    {
      "dot": "emerald",
      "title": "冪等性と記録",
      "items": [
        "spawn は brief を送り済みの Worker には何もしない",
        "approve は plan 状態のときだけ送る",
        "CSA への通知が届かなくても、タスク記録が正となり csa status で拾える"
      ]
    }
  ]
