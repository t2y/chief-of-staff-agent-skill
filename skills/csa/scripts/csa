#!/usr/bin/env bash
# csa — Chief of Staff Agent helper for herdr.
#   csa init                                       前提ツールを確かめ、csa を PATH に置き、CSA_HOME を用意する
#   csa up                                         CSA エージェントを起動する(冪等)
#   csa doctor                                     前提ツールと設定を確かめる(何も変更しない)
#   csa version                                    バージョンと skill の場所を表示する
#   csa spawn   [--no-eval] <ISSUE> <repo-path> <brief-file|->  Worker を起動して brief を渡す(冪等)
#   csa status                                     全タスクのファイル上の状態と herdr 上の状態
#   csa report  <ISSUE> <status> <note>            Worker と evaluator が呼ぶ。タスクファイルを更新し、CSA に知らせる
#   csa approve <ISSUE> [note]                     人間が承認した plan の実装開始を Worker に伝える
#   csa human   add|approve|list <ISSUE> ...       人間の発言を記録する、読む
#   csa eval    on|off <ISSUE> ...                 課題の評価を有効にする、止める
#   csa peek    <ISSUE> [lines] [--eval]           Worker(--eval なら evaluator)の画面の直近を読む
#   csa close   <ISSUE>                            Worker と evaluator の tab を閉じる(worktree は残す)
set -euo pipefail

SELF=$(readlink -f "${BASH_SOURCE[0]}")
SKILL_DIR=$(cd "$(dirname "$SELF")/.." && pwd)
ASSETS="$SKILL_DIR/assets"
EVALUATOR_DOC="$SKILL_DIR/references/evaluator.md"
WORKER_SKILL="$(dirname "$SKILL_DIR")/csa-worker/SKILL.md"

# csa が動作を確かめた herdr のバージョン。herdr CLI の JSON の形に依存しているため
HERDR_TESTED_VERSION="0.9.5"

# 同じ話題で実装の後の評価を行う回数の上限
EVAL_MAX_ROUNDS=3

CSA_HOME="${CSA_HOME:-$HOME/.csa}"
TASKS="$CSA_HOME/tasks"
WSDIR="$CSA_HOME/ws"
EVAL_DIR="$CSA_HOME/eval"
CSA_PLANS_DIR="${CSA_PLANS_DIR:-$CSA_HOME/plans}"
CSA_BIN_DIR="${CSA_BIN_DIR:-$HOME/.local/bin}"
CSA_KIND="${CSA_KIND:-claude}"
WORKER_KIND="${CSA_WORKER_KIND:-claude}"
CSA_PUSH="${CSA_PUSH:-1}"             # 0 にすると CSA への打ち込みをやめ、ファイル更新のみ
STATUS_JQ="${CSA_STATUS_JQ:-.result.agent.agent_status}"
CSA_UPDATE_CHECK="${CSA_UPDATE_CHECK:-1}"
CSA_UPDATE_URL="${CSA_UPDATE_URL:-https://raw.githubusercontent.com/t2y/chief-of-staff-agent-skill/main/skills/csa/SKILL.md}"

die() { echo "csa: $*" >&2; exit 1; }
warn() { echo "csa: $*" >&2; }

# SKILL.md の frontmatter から metadata.version を読む
skill_version() {
  awk '
    NR == 1 && $0 != "---" { exit }
    NR > 1 && $0 == "---" { exit }
    /^[[:space:]]+version:/ { v = $2; gsub(/["'\'']/, "", v); print v; exit }
  ' "$1"
}

# a が b より新しいバージョンなら真(数字をドットで区切った形だけを扱う)
version_gt() {
  awk -v a="$1" -v b="$2" 'BEGIN {
    na = split(a, x, "."); nb = split(b, y, ".")
    n = na > nb ? na : nb
    for (i = 1; i <= n; i++) {
      if ((x[i] + 0) > (y[i] + 0)) exit 0
      if ((x[i] + 0) < (y[i] + 0)) exit 1
    }
    exit 1
  }'
}

need_home() {
  [[ -d "$TASKS" ]] || die "$CSA_HOME が初期化されていません。先に 'csa init' を実行してください"
}

need_task() { # need_task issue → タスクファイルのパス
  need_home
  [[ -f "$TASKS/$1.md" ]] || die "no task: $1"
  echo "$TASKS/$1.md"
}

agent_name() { # agent_name issue [prefix] → herdr の agent 名(Worker は w-、evaluator は e-)
  local n
  n="${2:-w}-$(tr 'A-Z_' 'a-z-' <<<"$1")"
  [[ "$n" =~ ^[a-z][a-z0-9_-]{0,31}$ ]] || die "invalid agent name: $n"
  echo "$n"
}

alive() { herdr agent get "$1" >/dev/null 2>&1; }

# タスクファイルの先頭(--- より前)の key: value を読む
field() { awk -v k="$1:" '$0 == "---" { exit } $1==k{ $1=""; sub(/^ /,""); print; exit }' "$2"; }

# field の値。行がないか空なら既定値を返す
field_or() { local v; v=$(field "$1" "$3"); echo "${v:-$2}"; }

set_field() { # set_field key value file(行がなければ --- の直前に足す)
  local tmp; tmp=$(mktemp)
  # 値は ENVIRON で渡す(awk -v はバックスラッシュを解釈してしまう)
  K="$1:" V="$2" awk '
    BEGIN { k = ENVIRON["K"]; v = ENVIRON["V"] }
    !head_done && $1 == k && !done { print k " " v; done = 1; next }
    !head_done && $0 == "---" { if (!done) { print k " " v; done = 1 }; head_done = 1 }
    { print }
  ' "$3" >"$tmp"
  mv "$tmp" "$3"
}

one_line() { tr '\n' ' ' <<<"$1" | sed 's/[[:space:]]*$//'; }

log_task() { printf -- '- %s %s\n' "$(date '+%F %T')" "$(one_line "$2")" >>"$1"; }

# CSA のペインに知らせる。送れなくてもタスクファイルが正。CSA は 'csa status' で拾える
push_csa() {
  [[ "$CSA_PUSH" == 1 ]] || return 0
  herdr agent prompt csa "$1" >/dev/null 2>&1 \
    || warn "CSA への push に失敗しました(ファイルには記録済み)"
}

# Worker か evaluator に知らせる(完了は待たない)
tell_agent() {
  herdr agent prompt "$1" "$2" >/dev/null 2>&1 \
    || warn "$1 への送信に失敗しました。'csa peek' で確かめてください"
}

# Claude Code の権限ルールで使うパス表記(~/ はホーム、// は絶対パス)
# 権限ルールに書く文字列としての ~ なので展開しない
# shellcheck disable=SC2088
perm_path() {
  case "$1" in
    "$HOME"/*) echo "~/${1#"$HOME"/}" ;;
    *) echo "/$1" ;;
  esac
}

worker_allow_rules() {
  local p r
  p=$(perm_path "$CSA_PLANS_DIR"); r=$(perm_path "$EVAL_DIR/results")
  printf '%s\n' "Bash(csa report:*)" "Bash(csa human:*)" "Edit($p/**)" "Write($p/**)" "Edit($r/**)" "Write($r/**)"
}

# 前提ツールの確認。必須が欠けていれば 1 を返す。警告と推奨は表示だけ
check_tools() {
  local missing=() t k kinds have_ver settings rule
  for t in herdr jq git; do
    command -v "$t" >/dev/null 2>&1 || missing+=("$t")
  done
  kinds=$(printf '%s\n' "$CSA_KIND" "$WORKER_KIND" | awk '!seen[$0]++')
  while read -r k; do
    command -v "$k" >/dev/null 2>&1 || missing+=("$k (CSA_KIND / CSA_WORKER_KIND で指定したエージェント)")
  done <<<"$kinds"

  if ((${#missing[@]} > 0)); then
    echo "csa: 必要なツールが見つかりません。インストールしてから再実行してください:" >&2
    printf '  - %s\n' "${missing[@]}" >&2
    return 1
  fi

  have_ver=$(herdr --version 2>/dev/null | awk '{ print $2; exit }')
  if [[ "$have_ver" != "$HERDR_TESTED_VERSION" ]]; then
    warn "herdr ${have_ver:-(不明)} は未確認のバージョンです(確認済み: $HERDR_TESTED_VERSION)。動かない可能性があります"
  fi

  command -v curl >/dev/null 2>&1 || warn "curl がないため、新しいバージョンの確認を省きます"

  if grep -qx claude <<<"$kinds"; then
    settings="$HOME/.claude/settings.json"
    local lacking=()
    while read -r rule; do
      if [[ ! -f "$settings" ]] || ! jq -e --arg r "$rule" '(.permissions.allow // []) | index($r) != null' "$settings" >/dev/null 2>&1; then
        lacking+=("$rule")
      fi
    done < <(worker_allow_rules)
    if ((${#lacking[@]} > 0)); then
      warn "Claude Code の Worker と evaluator が止まらないよう、$settings の permissions.allow に次を足すことを推奨します:"
      printf '  "%s"\n' "${lacking[@]}" >&2
    fi
  fi
  return 0
}

link_self() {
  local target="$CSA_BIN_DIR/csa" cur
  mkdir -p "$CSA_BIN_DIR"
  # リンク切れ(skill の入れ直しで実体の場所が変わった場合など)は張り直す
  if [[ -L "$target" && ! -e "$target" ]]; then
    warn "$target はリンク切れ($(readlink "$target"))なので張り直します"
    rm "$target"
  fi
  if [[ -L "$target" || -e "$target" ]]; then
    cur=$(readlink -f "$target" 2>/dev/null || true)
    if [[ "$cur" != "$SELF" ]]; then
      die "$target はすでに別の場所(${cur:-不明})を指しています。確かめてから削除し、再実行してください"
    fi
  else
    ln -s "$SELF" "$target"
  fi
  case ":$PATH:" in
    *":$CSA_BIN_DIR:"*) ;;
    *) warn "$CSA_BIN_DIR が PATH にありません。シェルの設定に追加してください" ;;
  esac
}

sync_home() {
  mkdir -p "$TASKS" "$WSDIR" "$CSA_PLANS_DIR" "$CSA_HOME/.claude" \
    "$EVAL_DIR/criteria/repos" "$EVAL_DIR/context" "$EVAL_DIR/results"
  cp "$ASSETS/AGENTS.md" "$CSA_HOME/AGENTS.md"
  cp "$ASSETS/CLAUDE.md" "$CSA_HOME/CLAUDE.md"
  cp "$ASSETS/claude-settings.json" "$CSA_HOME/.claude/settings.json"
  cp "$ASSETS/eval-criteria.md" "$EVAL_DIR/criteria/default.md"
}

# 新しいバージョンがあれば知らせる。失敗しても何も言わずに続ける
update_notice() {
  [[ "$CSA_UPDATE_CHECK" == 1 ]] || return 0
  command -v curl >/dev/null 2>&1 || return 0
  local cache="$CSA_HOME/.update-check" now latest="" ts=0 local_ver
  now=$(date +%s)
  if [[ -f "$cache" ]]; then read -r ts latest <"$cache" || true; fi
  if ((now - ts >= 86400)) || [[ -z "$latest" ]]; then
    latest=$(curl -fsSL --max-time 3 "$CSA_UPDATE_URL" 2>/dev/null | skill_version /dev/stdin 2>/dev/null || true)
    [[ -n "$latest" ]] || return 0
    [[ -d "$CSA_HOME" ]] && echo "$now $latest" >"$cache"
  fi
  local_ver=$(skill_version "$SKILL_DIR/SKILL.md")
  if version_gt "$latest" "$local_ver"; then
    echo "csa: 新しいバージョン $latest があります(現在 $local_ver)。'npx skills update -g' で更新できます" >&2
  fi
  return 0
}

ensure_ws() { # repo → workspace_id(キャッシュ。stale なら呼び出し側で消して作り直す)
  local repo="$1" key f id
  key=$(basename "$repo"); f="$WSDIR/$key"
  if [[ -s "$f" ]]; then cat "$f"; return; fi
  id=$(herdr workspace create --cwd "$repo" --label "$key" --no-focus | jq -r '.result.workspace.workspace_id')
  [[ -n "$id" && "$id" != null ]] || die "workspace create failed"
  echo "$id" >"$f"; echo "$id"
}

# repo cwd label → tab create の JSON(stale な workspace_id なら 1 回だけ作り直す)
create_tab() {
  local repo="$1" cwd="$2" label="$3" ws out
  ws=$(ensure_ws "$repo")
  if ! out=$(herdr tab create --workspace "$ws" --cwd "$cwd" --label "$label" --no-focus 2>/dev/null); then
    rm -f "$WSDIR/$(basename "$repo")"
    ws=$(ensure_ws "$repo")
    out=$(herdr tab create --workspace "$ws" --cwd "$cwd" --label "$label" --no-focus)
  fi
  echo "$out"
}

ensure_worktree() { # repo issue → worktree path
  local repo="$1" issue="$2" wt branch exclude
  wt="$repo/.csa-worktrees/$issue"; branch="csa/$issue"
  if [[ ! -d "$wt" ]]; then
    if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
      git -C "$repo" worktree add "$wt" "$branch" >&2
    else
      git -C "$repo" worktree add -b "$branch" "$wt" >&2
    fi
  fi
  exclude="$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)/info/exclude"
  grep -qxF '.csa-worktrees/' "$exclude" 2>/dev/null || echo '.csa-worktrees/' >>"$exclude"
  echo "$wt"
}

# 既定のブランチとの merge-base(求められなければ HEAD)
merge_base() {
  local dir="$1" def b
  def=$(git -C "$dir" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)
  if [[ -z "$def" ]]; then
    for b in main master; do
      git -C "$dir" show-ref --verify --quiet "refs/heads/$b" && { def=$b; break; }
    done
  fi
  if [[ -n "$def" ]] && b=$(git -C "$dir" merge-base HEAD "$def" 2>/dev/null); then
    echo "$b"
  else
    git -C "$dir" rev-parse HEAD
  fi
}

# 差分の起点。タスクファイルになければ merge-base で代える
task_base() {
  local b; b=$(field_or base - "$1")
  if [[ "$b" == - ]]; then merge_base "$(field worktree "$1")"; else echo "$b"; fi
}

# remote のパス(ホスト名と .git を除いた部分)
remote_path() {
  git -C "$1" remote get-url origin 2>/dev/null | sed -E 's#^[a-z+]+://[^/]+/##; s#^[^@/]+@[^:]+:##; s#\.git$##'
}

# 評価の基準のうち存在するファイル
criteria_files() {
  local repo="$1" f
  for f in "$EVAL_DIR/criteria/default.md" "$EVAL_DIR/criteria/local.md" "$EVAL_DIR/criteria/repos/$(basename "$repo").md"; do
    [[ -f "$f" ]] && echo "$f"
  done
  return 0
}

# evaluator だけが読む文脈のうち、先頭の match: が remote のパスに前方一致するファイル
context_files() {
  local path f m
  path=$(remote_path "$1")
  [[ -n "$path" ]] || return 0
  for f in "$EVAL_DIR/context"/*.md; do
    [[ -f "$f" ]] || continue
    m=$(awk '/^match:/ { sub(/^match:[[:space:]]*/, ""); print; exit }' "$f")
    [[ -n "$m" && "$path" == "$m"* ]] && echo "$f"
  done
  return 0
}

# タスクファイルの brief の節(## brief から最後の ## log の前まで)
task_brief() {
  awk '
    { line[NR] = $0 }
    $0 == "## brief" && !start { start = NR }
    $0 == "## log" { stop = NR }
    END { for (i = start + 1; i < stop; i++) print line[i] }
  ' "$1"
}

cmd_init() {
  check_tools || exit 1
  link_self
  sync_home
  echo "csa $(skill_version "$SKILL_DIR/SKILL.md") を初期化しました"
  echo "  コマンド: $CSA_BIN_DIR/csa -> $SELF"
  echo "  CSA_HOME: $CSA_HOME"
  echo "次は herdr に接続した状態で 'csa up' を実行してください"
}

cmd_up() {
  check_tools || exit 1
  sync_home
  update_notice
  if alive csa; then
    echo "csa is already running"; return 0
  fi
  local pane
  pane=$(herdr workspace create --cwd "$CSA_HOME" --label csa --focus | jq -r '.result.root_pane.pane_id')
  [[ -n "$pane" && "$pane" != null ]] || die "workspace create failed"
  herdr agent start csa --kind "$CSA_KIND" --pane "$pane" --timeout 60000 >/dev/null
  echo "csa started in $pane — ふだんは csa ペインで話してください"
}

cmd_doctor() {
  local ok=0 found
  check_tools || ok=1
  found=$(command -v csa 2>/dev/null || true)
  if [[ -z "$found" ]]; then
    warn "csa が PATH にありません。'csa init' を実行してください"; ok=1
  elif [[ "$(readlink -f "$found")" != "$SELF" ]]; then
    warn "PATH 上の csa($found)はこの skill のものではありません"; ok=1
  fi
  if [[ ! -f "$WORKER_SKILL" ]]; then
    warn "csa-worker skill が見つかりません($WORKER_SKILL)。'npx skills add t2y/chief-of-staff-agent-skill -g --skill '*'' で入れてください"; ok=1
  fi
  [[ -d "$TASKS" ]] || { warn "$CSA_HOME が初期化されていません。'csa init' を実行してください"; ok=1; }
  update_notice
  ((ok == 0)) && echo "csa doctor: 問題は見つかりませんでした"
  return "$ok"
}

cmd_version() {
  echo "csa $(skill_version "$SKILL_DIR/SKILL.md")"
  echo "skill:        $SKILL_DIR"
  echo "worker skill: $(dirname "$WORKER_SKILL")"
}

cmd_spawn() {
  local eval_mode=on
  if [[ "${1:-}" == --no-eval ]]; then eval_mode=off; shift; fi
  [[ $# -eq 3 ]] || die "usage: csa spawn [--no-eval] <ISSUE> <repo-path> <brief-file|->"
  need_home
  [[ -f "$WORKER_SKILL" ]] || die "csa-worker skill が見つかりません($WORKER_SKILL)"
  local issue="$1" repo brief name task wt out pane tab plan base existed=0
  repo=$(cd "$2" && pwd)
  name=$(agent_name "$issue"); task="$TASKS/$issue.md"; plan="$CSA_PLANS_DIR/$issue.md"
  if [[ "$3" == "-" ]]; then brief=$(cat); else brief=$(cat "$3"); fi

  # 冪等性: brief を送り済みの Worker が生きていれば何もしない(二重起動・二重プロンプト防止)
  if alive "$name"; then
    if [[ -f "$task" && "$(field prompted "$task")" == yes ]]; then
      echo "already running: $name"; return 0
    fi
    # 起動はしたが brief をまだ送っていない(起動直後の確認で止まっていた)場合は、送るところから再開する
    wt=$(field worktree "$task" 2>/dev/null || true)
    [[ -n "$wt" ]] || die "$name は動いていますが、タスクファイルがありません。'csa peek $issue' で確かめてください"
    eval_mode=$(field_or eval on "$task")
    if ! herdr agent wait "$name" --until idle --timeout 30000 >/dev/null 2>&1; then
      warn "$name はまだ入力を受け付けられる状態ではありません。'csa peek $issue' で画面を確かめ、人間が承認してから再実行してください"
      return 1
    fi
  else
    git -C "$repo" show-ref --verify --quiet "refs/heads/csa/$issue" && existed=1
    wt=$(ensure_worktree "$repo" "$issue")
    # 既にあったブランチでは、作った時点の HEAD より前のコミットも評価の対象にする
    if ((existed)); then base=$(merge_base "$wt"); else base=$(git -C "$wt" rev-parse HEAD); fi
    out=$(create_tab "$repo" "$wt" "$issue")
    pane=$(jq -r '.result.root_pane.pane_id' <<<"$out")
    tab=$(jq -r '.result.tab.tab_id' <<<"$out")

    # 起動に失敗しても記録が残るよう、起動より先にタスクファイルを書く
    cat >"$task" <<EOF
issue: $issue
agent: $name
repo: $repo
worktree: $wt
branch: csa/$issue
tab: $tab
plan: -
prompted: no
status: working
eval: $eval_mode
eval_round: 0
eval_file: -
eval_tab: -
eval_head: -
eval_passed: -
eval_note: -
base: $base
---
## brief
$brief

## log
EOF
    log_task "$task" "spawned (eval: $eval_mode)"

    if ! out=$(herdr agent start "$name" --kind "$WORKER_KIND" --pane "$pane" --timeout 60000 2>&1); then
      set_field status blocked "$task"
      log_task "$task" "blocked: 起動直後に止まった($(jq -r '.error.code // empty' <<<"$out" 2>/dev/null || true))"
      warn "$name は起動直後の確認(フォルダの信頼など)で止まっている可能性があります。brief はまだ送っていません"
      warn "'csa peek $issue' で画面を確かめ、人間が承認したら同じ 'csa spawn' を再実行してください(そのとき brief を送ります)"
      return 1
    fi
  fi

  local prompt eval_lines="" f
  if [[ "$eval_mode" == on ]]; then
    eval_lines="
この課題では、review の報告のあとに evaluator が成果物を評価します。plan を書く前と review を報告する前に、次の評価の基準を読んでください。"
    while read -r f; do
      [[ -n "$f" ]] && eval_lines="$eval_lines
- $f"
    done < <(criteria_files "$repo")
  fi
  prompt="あなたは csa の Worker です。担当: $issue
作業ディレクトリ: $wt(ブランチ csa/$issue)
csa-worker skill に従って作業してください。skill として読み込めない場合は $WORKER_SKILL を読んでください。
plan を書く場合の保存先: $plan$eval_lines

## brief
$brief"
  # --until working: 着手したことだけ確認して戻る(完了までは待たない)
  if ! herdr agent prompt "$name" "$prompt" --wait --until working --timeout 30000 >/dev/null; then
    # 送れたかどうか分からないので、送り済みとして扱い、再送はしない
    set_field prompted yes "$task"
    warn "prompt 送信を確認できませんでした。再送せず 'csa peek $issue' で確認してください"
    return 1
  fi
  set_field prompted yes "$task"
  set_field status working "$task"
  log_task "$task" "prompted"
  echo "spawned: $name"
}

cmd_status() {
  need_home
  local f issue name st live plan
  printf '%-16s %-18s %-10s %-12s %s\n' ISSUE AGENT FILE HERDR PLAN
  for f in "$TASKS"/*.md; do
    [[ -e "$f" ]] || { echo "(no tasks)"; return 0; }
    issue=$(field issue "$f"); name=$(field agent "$f"); st=$(field status "$f")
    # 評価中は evaluator の状態を見せる(権限の確認で止まっていないかを確かめるため)
    [[ "$st" == eval ]] && name=$(agent_name "$issue" e)
    if ! live=$(herdr agent get "$name" 2>/dev/null | jq -r "$STATUS_JQ"); then live="(not running)"; fi
    plan=""
    [[ "$st" == plan ]] && plan=$(field plan "$f")
    [[ "$st" == eval ]] && plan=$(field eval_file "$f")
    printf '%-16s %-18s %-10s %-12s %s\n' "$issue" "$name" "$st" "$live" "$plan"
  done
}

# 評価を挟むかどうか: off|limit|passed|nodiff|dirty|run
eval_decision() {
  local task="$1" wt head n
  [[ "$(field_or eval on "$task")" == off ]] && { echo off; return; }
  (($(field_or eval_round 0 "$task") >= EVAL_MAX_ROUNDS)) && { echo limit; return; }
  wt=$(field worktree "$task")
  head=$(git -C "$wt" rev-parse HEAD)
  [[ "$head" == "$(field_or eval_passed - "$task")" ]] && { echo passed; return; }
  n=$(git -C "$wt" rev-list --count "$(task_base "$task")..HEAD" 2>/dev/null || echo 1)
  ((n == 0)) && { echo nodiff; return; }
  [[ -n "$(git -C "$wt" status --porcelain --untracked-files=no)" ]] && { echo dirty; return; }
  echo run
}

# 評価の結果のファイルの次の通し番号
next_eval_file() {
  local dir="$EVAL_DIR/results/$1" n=1
  mkdir -p "$dir"
  while [[ -e "$dir/impl-$n.md" ]]; do n=$((n + 1)); done
  echo "$dir/impl-$n.md"
}

eval_prompt() { # eval_prompt issue task eval_file round
  local issue="$1" task="$2" file="$3" round="$4" wt repo plan prev="なし" n f lines=""
  wt=$(field worktree "$task"); repo=$(field repo "$task"); plan=$(field_or plan - "$task")
  [[ "$plan" == - ]] && plan="なし(brief の受け入れ条件を完了の定義とする)"
  n=$(basename "$file" .md); n=${n#impl-}
  if ((round > 1 && n > 1)) && [[ -f "$(dirname "$file")/impl-$((n - 1)).md" ]]; then
    prev="$(dirname "$file")/impl-$((n - 1)).md"
  fi
  while read -r f; do [[ -n "$f" ]] && lines="$lines
- 基準: $f"; done < <(criteria_files "$repo")
  while read -r f; do [[ -n "$f" ]] && lines="$lines
- 文脈(evaluator だけが読む): $f"; done < <(context_files "$wt")
  cat <<EOF
あなたは csa の evaluator です。担当: $issue(この話題での $round 回目の評価)
作業ディレクトリ: $wt(ブランチ csa/$issue)
手順書 $EVALUATOR_DOC を読み、それに従って評価してください。
追跡されているファイルの編集、コミット、push はしないでください。

- 結果を書くファイル: $file
- 前の回の評価: $prev
- 差分の起点: $(task_base "$task")(git diff と git log で <起点>..HEAD を読む)
- plan: $plan
- 人間の発言: 'csa human list $issue' を実行して読む$lines

書き終えたら 'csa report $issue evaluated "<要約>"' を実行してください。

## brief
$(task_brief "$task")
EOF
}

# evaluator を起動する。count=1 なら回数を数える
eval_start() { # eval_start issue task count
  local issue="$1" task="$2" count="$3" name wt repo out pane tab file round prompt
  name=$(agent_name "$issue" e); wt=$(field worktree "$task"); repo=$(field repo "$task")
  eval_close_tab "$task"
  round=$(field_or eval_round 0 "$task")
  # 回数は起動を試みた時点で数える。起動し直し(count=0)では数えない
  if ((count)); then round=$((round + 1)); set_field eval_round "$round" "$task"; fi
  ((round > 0)) || round=1
  file=$(field_or eval_file - "$task")
  [[ "$file" == - || -e "$file" ]] && file=$(next_eval_file "$issue")
  set_field eval_file "$file" "$task"
  set_field eval_head "$(git -C "$wt" rev-parse HEAD)" "$task"

  if ! out=$(create_tab "$repo" "$wt" "$issue-eval" 2>/dev/null); then
    eval_start_failed "$issue" "$task" "tab を作れなかった"; return 1
  fi
  pane=$(jq -r '.result.root_pane.pane_id' <<<"$out"); tab=$(jq -r '.result.tab.tab_id' <<<"$out")
  set_field eval_tab "$tab" "$task"
  if ! herdr agent start "$name" --kind "$WORKER_KIND" --pane "$pane" --timeout 60000 >/dev/null 2>&1; then
    eval_start_failed "$issue" "$task" "起動直後に止まった"; return 1
  fi
  prompt=$(eval_prompt "$issue" "$task" "$file" "$round")
  if ! herdr agent prompt "$name" "$prompt" --wait --until working --timeout 30000 >/dev/null 2>&1; then
    eval_start_failed "$issue" "$task" "prompt の送信を確認できなかった"; return 1
  fi
  set_field status eval "$task"
  log_task "$task" "eval started: $round 回目 $file"
}

eval_start_failed() { # eval_start_failed issue task reason
  set_field status blocked "$2"
  log_task "$2" "blocked: evaluator を起動できなかった($3)"
  push_csa "[report] $1 blocked: evaluator を起動できなかった($3)。'csa peek $1 --eval' で確かめ、解消したら 'csa eval on $1' で起動し直す"
  warn "evaluator を起動できませんでした($3)。CSA に知らせました"
}

eval_close_tab() {
  local tab; tab=$(field_or eval_tab - "$1")
  [[ "$tab" == - ]] && return 0
  set_field eval_tab - "$1"
  herdr tab close "$tab" >/dev/null 2>&1 || true
}

# eval のファイルの verdict
eval_verdict() { awk '/^verdict:/ { print $2; exit }' "$1" 2>/dev/null || true; }

# eval のファイルの節(## <title>)にある ### の見出しを読点でつなぐ
eval_headings() {
  awk -v t="## $2" '
    $0 == t { on = 1; next }
    /^## / { on = 0 }
    on && /^### / { sub(/^### /, ""); out = out (out == "" ? "" : "、") $0 }
    END { print out }
  ' "$1" 2>/dev/null || true
}

eval_count() { # eval_count file title → 節にある ### の見出しの数
  awk -v t="## $2" '$0 == t { on = 1; next } /^## / { on = 0 } on && /^### / { n++ } END { print n + 0 }' "$1" 2>/dev/null || echo 0
}

escalation_msg() { # escalation_msg issue file trigger topic
  echo "[report] $1 blocked: 評価で要相談($3)。eval: $2。論点: ${4:-(eval を読む)}。人間の判断: (a) Worker の案で進める (b) 評価の指摘に従う (c) 範囲か方針を変える (d) 打ち切る"
}

report_review() { # report_review issue task note → 0 なら通常の review として扱う
  local issue="$1" task="$2" note="$3" st
  st=$(field status "$task")
  [[ "$st" == eval ]] && die "$issue は評価中です。evaluator の結果を待ってください"
  case "$(eval_decision "$task")" in
    off|limit|passed) return 0 ;;
    nodiff) REVIEW_SUFFIX=" / 評価: 省略(差分なし)"; log_task "$task" "eval skipped: 差分なし"; return 0 ;;
    dirty) die "追跡されているファイルにコミットしていない変更があります。コミットしてから review を報告してください" ;;
  esac
  set_field eval_note "$(one_line "$note")" "$task"
  log_task "$task" "review: $note"
  eval_start "$issue" "$task" 1 || return 1
  echo "evaluator を起動しました。結果が届くまで待ってください(push はまだしない)"
  return 1
}

report_evaluated() { # report_evaluated issue task note
  local issue="$1" task="$2" note="$3" file verdict wt worker wnote round msg
  log_task "$task" "evaluated: $note"
  if [[ "$(field status "$task")" != eval ]]; then
    log_task "$task" "評価の結果は記録だけにした(状態が eval でない)"
    eval_close_tab "$task"; return 0
  fi
  file=$(field eval_file "$task"); wt=$(field worktree "$task"); worker=$(field agent "$task")
  wnote=$(field_or eval_note - "$task"); round=$(field_or eval_round 0 "$task")
  set_field eval_file - "$task"
  if [[ "$(git -C "$wt" rev-parse HEAD)" != "$(field eval_head "$task")" || -n "$(git -C "$wt" status --porcelain --untracked-files=no)" ]]; then
    set_field status blocked "$task"
    push_csa "[report] $issue blocked: 評価中に worktree が変わったので評価を無効にした。eval: $file"
    eval_close_tab "$task"; return 0
  fi
  verdict=$(eval_verdict "$file")
  case "$verdict" in
    pass)
      set_field eval_round 0 "$task"
      set_field eval_passed "$(git -C "$wt" rev-parse HEAD)" "$task"
      set_field status review "$task"
      push_csa "[report] $issue review: $wnote / 評価: 合格(助言 $(eval_count "$file" 助言) 件)$file"
      tell_agent "$worker" "評価に合格しました($file)。助言は参考として読んでください。push の許可がある課題では、ここで push してよいです。push したら、もう一度 review で報告してください。"
      ;;
    abstain)
      set_field status review "$task"
      msg=$(awk '/^verdict:/ { f = 1; next } f && NF { print; exit }' "$file")
      push_csa "[report] $issue review: $wnote / 評価: 棄権(${msg:-理由なし})$file"
      tell_agent "$worker" "evaluator は評価を棄権しました($file)。push の許可がある課題では、許可に従って push してよいです。"
      ;;
    fail)
      if ((round >= EVAL_MAX_ROUNDS)); then
        set_field status blocked "$task"
        push_csa "$(escalation_msg "$issue" "$file" "同じ話題で $EVAL_MAX_ROUNDS 回不合格" "$(eval_headings "$file" 不合格)")"
      else
        set_field status working "$task"
        tell_agent "$worker" "評価が不合格でした($round/$EVAL_MAX_ROUNDS 回目)。$file の「不合格」の指摘を直して、コミットしてから、もう一度 review で報告してください。push はしないでください。同意できない指摘があれば、直さずに 'csa report $issue blocked \"評価の指摘 <見出し> に同意できない: <理由>\"' で止まってください。"
      fi
      ;;
    escalate)
      set_field status blocked "$task"
      push_csa "$(escalation_msg "$issue" "$file" "evaluator が判断できない" "$(eval_headings "$file" 要相談)")"
      ;;
    *)
      set_field status blocked "$task"
      push_csa "[report] $issue blocked: eval の verdict を読めなかった(${verdict:-なし})。eval: $file"
      ;;
  esac
  log_task "$task" "eval result: ${verdict:-unknown} $file"
  # evaluator のペインで動いているので、送信をすべて終えてから最後に tab を閉じる
  eval_close_tab "$task"
}

cmd_report() {
  [[ $# -eq 3 ]] || die "usage: csa report <ISSUE> <working|blocked|plan|review|done|evaluated> <note>"
  local issue="$1" st="$2" note="$3" task plan prev
  task=$(need_task "$issue")
  case "$st" in working|blocked|plan|review|done|evaluated) ;; *) die "bad status: $st" ;; esac
  if [[ "$st" == evaluated ]]; then report_evaluated "$issue" "$task" "$note"; return 0; fi
  if [[ "$st" == plan ]]; then
    plan="$CSA_PLANS_DIR/$issue.md"
    [[ -f "$plan" ]] || die "plan ファイルがありません: $plan(書いてから報告してください)"
    set_field plan "$plan" "$task"
  fi
  REVIEW_SUFFIX=""
  if [[ "$st" == review ]]; then
    report_review "$issue" "$task" "$note" || return 0
  fi
  prev=$(field status "$task")
  # blocked の後は人間の判断が入っているので、新しい話題として評価の回数を数え直す
  [[ "$prev" == blocked && "$st" == working ]] && set_field eval_round 0 "$task"
  set_field status "$st" "$task"
  log_task "$task" "$st: $note$REVIEW_SUFFIX"
  [[ "$st" != working ]] && push_csa "[report] $issue $st: $note$REVIEW_SUFFIX"
  return 0
}

cmd_approve() {
  [[ $# -ge 1 && $# -le 2 ]] || die "usage: csa approve <ISSUE> [note]"
  local issue="$1" note="${2:-}" task st plan name msg
  task=$(need_task "$issue")
  st=$(field status "$task")
  # 二重承認の防止: plan 状態のときだけ送る
  [[ "$st" == plan ]] || die "$issue は plan 状態ではありません(現在: $st)。何も送りません"
  plan=$(field plan "$task")
  [[ -f "$plan" ]] || die "plan ファイルがありません: $plan"
  name=$(field agent "$task")
  msg="plan($plan)が承認されました。plan に沿って実装を始めてください。"
  [[ -n "$note" ]] && msg="$msg
補足: $note"
  if ! herdr agent prompt "$name" "$msg" --wait --until working --timeout 30000 >/dev/null; then
    warn "送信を確認できませんでした。状態は plan のままです。再送せず 'csa peek $issue' で確認してください"
    return 1
  fi
  set_field status working "$task"
  log_task "$task" "approved: ${note:-(no note)}"
  echo "approved: $issue"
}

# human(<by>)[ <kind>]: 「<引用>」 / 読み取り: <読み取り> の行を書く
human_log() { # human_log task by kind quote reading
  local line
  [[ -n "${4//[[:space:]]/}" ]] || die "人間の発言の引用が空です"
  case "$2" in csa|worker|evaluator) ;; *) die "--by は csa、worker、evaluator のどれかです: ${2:-(なし)}" ;; esac
  line="human($2)${3:+ $3}: 「$(one_line "$4")」"
  [[ -n "$5" ]] && line="$line / 読み取り: $(one_line "$5")"
  log_task "$1" "$line"
}

cmd_human() {
  local sub="${1:-}" by="" task
  shift || true
  case "$sub" in
    add)
      [[ $# -ge 1 ]] || die "usage: csa human add <ISSUE> --by <csa|worker|evaluator> \"<発言の引用>\" [\"<読み取り>\"]"
      task=$(need_task "$1"); shift
      [[ "${1:-}" == --by ]] && { by="${2:-}"; shift 2 || true; }
      [[ $# -ge 1 && $# -le 2 ]] || die "usage: csa human add <ISSUE> --by <csa|worker|evaluator> \"<発言の引用>\" [\"<読み取り>\"]"
      human_log "$task" "$by" "" "$1" "${2:-}"
      ;;
    approve)
      [[ $# -ge 2 && $# -le 3 ]] || die "usage: csa human approve <ISSUE> \"<発言の引用>\" [\"<読み取り>\"]"
      task=$(need_task "$1")
      [[ "$(field status "$task")" == plan ]] || die "$1 は plan 状態ではありません(現在: $(field status "$task"))。何も変えません"
      human_log "$task" worker approve "$2" "${3:-}"
      set_field status working "$task"
      ;;
    list)
      [[ $# -eq 1 ]] || die "usage: csa human list <ISSUE>"
      task=$(need_task "$1")
      grep -E '^- [0-9-]+ [0-9:]+ (human\(|approved: )' "$task" || true
      ;;
    *) die "usage: csa human add|approve|list <ISSUE> ..." ;;
  esac
}

cmd_eval() {
  local sub="${1:-}" issue task by="" st
  shift || true
  case "$sub" in
    off)
      [[ $# -ge 1 ]] || die "usage: csa eval off <ISSUE> --by <csa|worker|evaluator> \"<人間の発言の引用>\""
      issue="$1"; task=$(need_task "$issue"); shift
      [[ "${1:-}" == --by ]] && { by="${2:-}"; shift 2 || true; }
      [[ $# -eq 1 ]] || die "usage: csa eval off <ISSUE> --by <csa|worker|evaluator> \"<人間の発言の引用>\""
      human_log "$task" "$by" eval-off "$1" ""
      set_field eval off "$task"
      st=$(field status "$task")
      if [[ "$st" == eval ]]; then
        set_field eval_file - "$task"
        set_field status review "$task"
        push_csa "[report] $issue review: $(field_or eval_note - "$task") / 評価: off(人間の指示)"
      fi
      eval_close_tab "$task"
      echo "eval off: $issue"
      ;;
    on)
      [[ $# -eq 1 ]] || die "usage: csa eval on <ISSUE>"
      issue="$1"; task=$(need_task "$issue")
      set_field eval on "$task"
      st=$(field status "$task")
      # 起動に失敗したか、止まった評価を起動し直す(回数に数えない)
      if [[ "$(field_or eval_file - "$task")" != - && ( "$st" == eval || "$st" == blocked ) ]]; then
        log_task "$task" "eval restarted"
        eval_start "$issue" "$task" 0 || return 1
        echo "evaluator を起動し直しました: $issue"
      else
        log_task "$task" "eval on"
        echo "eval on: $issue"
      fi
      ;;
    *) die "usage: csa eval on|off <ISSUE> ..." ;;
  esac
}

cmd_peek() {
  local issue="" lines=60 prefix=w a name out
  for a in "$@"; do
    case "$a" in
      --eval) prefix=e ;;
      *) if [[ -z "$issue" ]]; then issue="$a"; else lines="$a"; fi ;;
    esac
  done
  [[ -n "$issue" ]] || die "usage: csa peek <ISSUE> [lines] [--eval]"
  name=$(agent_name "$issue" "$prefix")
  out=$(herdr agent read "$name" --source recent-unwrapped --lines "$lines")
  # Codex のように代替スクリーンを使うエージェントはスクロールバックが空なので、見えている画面を読む
  if [[ -z "${out//[[:space:]]/}" ]]; then
    out=$(herdr agent read "$name" --source visible --lines "$lines")
  fi
  printf '%s\n' "$out"
}

cmd_close() {
  [[ $# -eq 1 ]] || die "usage: csa close <ISSUE>"
  local task tab
  task=$(need_task "$1")
  eval_close_tab "$task"
  tab=$(field tab "$task")
  herdr tab close "$tab"
  log_task "$task" "closed (worktree kept)"
}

sub="${1:-}"; shift || true
case "$sub" in
  init)    cmd_init ;;
  up)      cmd_up ;;
  doctor)  cmd_doctor ;;
  version) cmd_version ;;
  spawn)   cmd_spawn "$@" ;;
  status)  cmd_status ;;
  report)  cmd_report "$@" ;;
  approve) cmd_approve "$@" ;;
  human)   cmd_human "$@" ;;
  eval)    cmd_eval "$@" ;;
  peek)    cmd_peek "$@" ;;
  close)   cmd_close "$@" ;;
  *) sed -n '2,14p' "$SELF"; exit 2 ;;
esac
